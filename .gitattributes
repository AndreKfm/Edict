* text=auto eol=lf
*.dll binary
*.pak binary
*.bsp binary
*.dem binary
*.edh binary

# Pristine id Software sources: keep the bytes exactly as upstream.
ref/upstream/** -text

# Windows batch files: cmd.exe reads CRLF lines
*.cmd text eol=crlf

# GitHub language statistics (Linguist): id's pristine tree is vendored code, so the port's C# is the repository's language
ref/upstream/** linguist-vendored
